{
  "name": "neural-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Official Neural UI v2 agent skill and reproducible public API verification",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "api:generate": "node scripts/api.mjs --write",
    "api:check": "node scripts/api.mjs --check",
    "api:native:generate": "node scripts/native-api.mjs --write",
    "api:native:check": "node scripts/native-api.mjs --check",
    "validate:native": "node scripts/validate-native.mjs",
    "build:native:examples": "ngc -p tests/native/tsconfig.json",
    "build:native:browser": "vite build --config tests/native/vite.config.ts",
    "test:native:browser": "playwright test --config tests/native/playwright.config.ts",
    "verify:native": "npm run api:native:check && npm run validate:native && npm run build:native:examples && npm run build:native:browser && npm run test:native:browser",
    "package:native": "node scripts/package.mjs --native",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:examples": "cd tests/integration && ng build --configuration production",
    "test:integration": "playwright test",
    "test:clean-install": "node scripts/verify-clean-install.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "test:mcp": "node --test tests/mcp/*.test.mjs",
    "test:mcp:package": "node scripts/verify-mcp-package.mjs",
    "test:mcp:registry": "node scripts/verify-mcp-registry.mjs",
    "test:mcp:registry:current": "node scripts/verify-mcp-registry.mjs --current",
    "check:mcp:name": "node scripts/check-mcp-name.mjs",
    "check:mcp:security": "node scripts/audit-mcp.mjs",
    "verify:mcp": "npm run build:mcp && npm run test:mcp && npm run check:mcp:security && npm run test:mcp:package",
    "check:links": "node scripts/links.mjs",
    "check:sources": "node scripts/provenance.mjs",
    "release:prepare": "npm run verify && npm run check:links && npm run check:sources && node scripts/package.mjs",
    "verify": "npm run api:check && npm run validate && npm test && npm run build:examples && npm run test:integration"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "22.2.2",
    "@angular/build": "22.2.2",
    "@angular/cdk": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/ssr": "22.2.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@neural-ui/core": "2.0.1",
    "@neural-ui/native": "0.1.0-beta.2",
    "@ng-native/web": "0.18.2",
    "@playwright/test": "1.63.0",
    "@schematics/angular": "22.2.2",
    "@types/express": "5.0.5",
    "@types/node": "22.19.0",
    "express": "5.1.0",
    "typescript": "6.0.3",
    "yaml": "2.8.1"
  }
}
